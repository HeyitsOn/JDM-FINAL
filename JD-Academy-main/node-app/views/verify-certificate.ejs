<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Verify Certificate — JDM Academy</title>
<style>
    body { font-family: 'Helvetica Neue', Arial, sans-serif; background:#0A1628; color:#e2e8f5; min-height:100vh; margin:0; display:flex; align-items:center; justify-content:center; padding:24px; }
    .card { background:#101d38; border:1px solid #1c2d4f; border-radius:16px; padding:40px; max-width:480px; width:100%; text-align:center; }
    h1 { font-size:1.3rem; margin-bottom:24px; }
    .logo { font-weight:bold; color:#E31937; letter-spacing:1px; margin-bottom:24px; }
    form { display:flex; gap:8px; margin-bottom:24px; }
    input { flex:1; padding:12px 14px; border-radius:8px; border:1px solid #2d4070; background:#0A1628; color:#fff; font-size:14px; }
    button { background:#0033A0; color:#fff; border:none; padding:12px 20px; border-radius:8px; cursor:pointer; font-weight:600; }
    .result-valid { background:rgba(34,197,94,.1); border:1px solid #22c55e; border-radius:10px; padding:20px; text-align:left; }
    .result-invalid { background:rgba(227,25,55,.1); border:1px solid #E31937; border-radius:10px; padding:20px; }
    .row { margin-bottom:8px; font-size:14px; }
    .row strong { color:#94a3b8; display:inline-block; width:110px; }
</style>
</head>
<body>
    <div class="card">
        <div class="logo">JDM ACADEMY</div>
        <h1>Certificate Verification</h1>
        <form method="get">
            <input type="text" name="code" placeholder="e.g. JDM-A1B2-C3D4" value="<%= code %>" required>
            <button type="submit">Verify</button>
        </form>

        <% if (code) { %>
            <% if (result) { %>
                <div class="result-valid">
                    <div class="row"><strong>Status:</strong> ✅ Valid Certificate</div>
                    <div class="row"><strong>Student:</strong> <%= result.name %></div>
                    <div class="row"><strong>Course:</strong> <%= result.level_label %></div>
                    <div class="row"><strong>Issued:</strong> <%= new Date(result.issued_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) %></div>
                </div>
            <% } else { %>
                <div class="result-invalid">
                    ❌ No certificate found with that code. Please check it and try again.
                </div>
            <% } %>
        <% } %>
    </div>
</body>
</html>
