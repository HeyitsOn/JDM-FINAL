<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>My Certificates — JDM Academy</title>
<style>
    body { font-family: 'Helvetica Neue', Arial, sans-serif; background:#0A1628; color:#e2e8f5; min-height:100vh; margin:0; padding:24px; }
    .wrap { max-width:640px; margin:0 auto; }
    .logo { font-weight:bold; color:#E31937; letter-spacing:1px; margin-bottom:8px; }
    h1 { font-size:1.4rem; margin:0 0 4px; }
    .sub { color:#94a3b8; margin-bottom:28px; }
    .card { background:#101d38; border:1px solid #1c2d4f; border-radius:16px; padding:24px; margin-bottom:16px; }
    .card h2 { font-size:1.05rem; margin:0 0 14px; color:#94a3b8; text-transform:uppercase; letter-spacing:1px; }
    .row { display:flex; justify-content:space-between; align-items:center; padding:12px 0; border-top:1px solid #1c2d4f; }
    .row:first-of-type { border-top:none; }
    .row-title { font-weight:600; }
    .row-sub { color:#94a3b8; font-size:0.85rem; margin-top:2px; }
    .btn { background:#0033A0; color:#fff; border:none; padding:9px 16px; border-radius:8px; cursor:pointer; font-weight:600; font-size:0.85rem; text-decoration:none; white-space:nowrap; }
    .btn-outline { background:none; border:1px solid #2d4070; color:#e2e8f5; }
    .empty { color:#94a3b8; text-align:center; padding:12px 0; }
    a.home-link { color:#94a3b8; font-size:0.85rem; }
</style>
</head>
<body>
<div class="wrap">
    <div class="logo">JDM ACADEMY</div>
    <h1>My Certificates</h1>
    <div class="sub">Welcome, <%= studentName %></div>

    <div class="card">
        <h2>Earned Certificates</h2>
        <% if (certificates.length === 0) { %>
            <div class="empty">You haven't earned a certificate yet — complete all the topics in a level below to unlock one.</div>
        <% } else { %>
            <% certificates.forEach(function(c) { %>
                <div class="row">
                    <div>
                        <div class="row-title"><%= c.level_label %></div>
                        <div class="row-sub">Issued <%= new Date(c.issued_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) %> · <%= c.certificate_code %></div>
                    </div>
                    <a class="btn" href="/generate-certificate?level=<%= encodeURIComponent(c.level_key) %>">View / Print</a>
                </div>
            <% }) %>
        <% } %>
    </div>

    <div class="card">
        <h2>Progress by Level</h2>
        <% levels.forEach(function(lvl) { %>
            <div class="row">
                <div>
                    <div class="row-title"><%= lvl.levelLabel %></div>
                    <div class="row-sub"><%= lvl.topicsCompleted %> / <%= lvl.requiredTopics %> topics completed</div>
                </div>
                <% if (lvl.levelComplete) { %>
                    <a class="btn" href="/generate-certificate?level=<%= encodeURIComponent(lvl.levelKey) %>">Get Certificate</a>
                <% } else { %>
                    <a class="btn btn-outline" href="/#<%= lvl.levelKey %>">Continue</a>
                <% } %>
            </div>
        <% }) %>
    </div>

    <a class="home-link" href="/">← Back to JDM Academy</a>
</div>
</body>
</html>
