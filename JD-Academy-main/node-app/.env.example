# Node.js Environment
# Use 'development' for local work, 'production' when deployed -- this
# controls whether session cookies are marked secure (HTTPS-only).
NODE_ENV=production
PORT=

# Session Configuration
# Generate a long random value, e.g.: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Never reuse a value from local development or this file's own history.
SESSION_SECRET=

# Database Configuration
DB_HOST=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASS=

# Application URL (used for certificate verification links) -- the real
# public domain, not localhost.
SITE_URL=

# Optional: Session lifetime in seconds (default: 30 days if unset)
SESSION_LIFETIME=
